# Copy this file to .env and fill in your values
# Never commit .env to git

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Webex Bot (create at https://developer.webex.com/my-apps)
WEBEX_BOT_TOKEN=...

# Webhook HMAC secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBEX_WEBHOOK_SECRET=
